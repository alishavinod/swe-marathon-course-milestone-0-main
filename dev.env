# dev.env — template for environment configuration. Copy to repo root and fill in values.

# Uses the default AWS credential chain:
# env vars → ~/.aws/credentials → attached role (EC2/ECS/Lambda)
AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID="<your-aws-access-key-id>"
AWS_SECRET_ACCESS_KEY="<your-aws-secret-access-key>"

BEDROCK_ARN_GPT_5_6_LUNA="arn:aws:bedrock:us-east-1:<account-id>:inference-profile/<profile-id>"

OPENROUTER_API_KEY="<your-openrouter-key>"
OPENAI_API_KEY=""
